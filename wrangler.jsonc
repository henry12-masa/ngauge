{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ngauge-curation",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ngauge-curation",
			"database_id": "bd2497bb-605b-4695-a9b9-02644009dd59",
		},
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "4eb11a3442a2464c860f26c61e368333",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "ngauge-curation-media",
		},
	],
	"routes": [{ "pattern": "ngauge.napoblog.com", "custom_domain": true }],
	"triggers": {
		"crons": ["* * * * *"],
	},
}
